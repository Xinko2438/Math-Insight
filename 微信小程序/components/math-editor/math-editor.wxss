@import "../../vendor/math/runtime.wxss";
.editor-mask{position:fixed;top:0;left:0;right:0;z-index:200;}
.editor-backdrop{position:absolute;inset:0;background:rgba(24,34,55,.25);}
.editor-sheet{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;overflow:hidden;background:#f5f7fb;border-radius:28rpx 28rpx 0 0;padding:0 24rpx;box-sizing:border-box;}
.sheet-head{display:flex;align-items:center;justify-content:space-between;flex-shrink:0;height:52px;border-bottom:1rpx solid #e5eaf2;}
.sheet-title{font-size:30rpx;font-weight:500;color:#182237;}
.sheet-action{font-size:28rpx;color:#647086;background:transparent;padding:10rpx;min-height:44px;line-height:1.6;}
.sheet-action.done{color:#3266ed;}
button::after{border:0;}
.sheet-content,.math-canvas{flex:1;min-height:0;height:0;box-sizing:border-box;}
.text-editor{width:100%;min-height:180rpx;box-sizing:border-box;padding:24rpx 8rpx;font-size:30rpx;line-height:1.8;color:#182237;}
.visual-hint{flex-shrink:0;color:#788397;font-size:24rpx;height:30px;display:flex;align-items:center;padding:0 8rpx;}
.formula-stage{display:inline-block;min-width:100%;min-height:100%;box-sizing:border-box;padding:14px 18px 18px;font-size:48rpx;white-space:nowrap;}
.native-node{display:inline-block;}
.tap-token{position:relative;border-radius:3px;}
.tap-token.active-token{background:#dbe7ff;color:#164ed6;box-shadow:inset 0 -2px #3266ed;}
.tap-token.caret-token::after{content:"";position:absolute;right:-1px;top:12%;height:76%;border-right:2px solid #3266ed;pointer-events:none;}
.editor-error,.sheet-note{flex-shrink:0;font-size:24rpx;color:#9a5038;line-height:1.5;padding:4px 8rpx;}
.math-keypad{flex-shrink:0;border-top:1rpx solid #e0e6ef;padding-top:4px;}
.keypad-tools{display:flex;align-items:center;height:44px;}
.keypad-tabs{display:flex;flex:1;min-width:0;}
.keypad-tab,.pad-tool{width:44px;min-width:40px;height:44px;line-height:44px;padding:0;margin:0;color:#647086;background:transparent;font-size:26rpx;font-weight:400;border-radius:8px;}
.keypad-tab.chosen{color:#3266ed;background:#e8eefb;}
.pad-tool{font-size:48rpx;flex-shrink:0;}
.pad-tool.undo{font-size:40rpx;}
.pad-tool[disabled],.pad-tool.muted{color:#b5becc;background:transparent;}
.keypad-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));grid-template-rows:repeat(4,minmax(0,1fr));gap:6px;height:256px;padding:6px 0;box-sizing:border-box;}
.keypad-grid.letters{grid-template-columns:repeat(6,minmax(0,1fr));grid-template-rows:repeat(5,minmax(0,1fr));height:256px;}
.math-key{display:flex;align-items:center;justify-content:center;width:100%;height:100%;min-height:44px;min-width:0;margin:0;padding:0;background:#fff;border-radius:8px;color:#182237;font-size:38rpx;line-height:1;font-weight:400;box-shadow:0 1px 0 #dde3ec;}
.keypad-grid.letters .math-key{font-size:32rpx;}
.key-pressed{background:#dce7ff;color:#164ed6;}
.structure-bar{display:flex;height:44px;margin-top:4px;}
.structure-bar button{flex:1;min-width:0;height:44px;line-height:44px;padding:0;margin:0;color:#3266ed;background:transparent;font-size:36rpx;font-weight:400;}
.structure-bar .system-key{font-size:25rpx;}
.fraction-key{display:inline-flex;vertical-align:middle;flex-direction:column;align-items:center;justify-content:center;line-height:15px;width:20px;font-size:14px;font-family:KaTeX_Math;font-style:italic;}
.fraction-key text:first-child{border-bottom:1px solid currentColor;width:100%;line-height:15px;}
@keyframes mask-enter{from{opacity:0}to{opacity:1}}
@keyframes mask-exit{from{opacity:1}to{opacity:0}}
.editor-mask.closing{opacity:0;pointer-events:none;}
@media(prefers-reduced-motion:no-preference){.editor-mask{animation:mask-enter 140ms ease-out}.editor-mask.closing{animation:mask-exit 180ms ease-out forwards}.math-key{transition:background-color 100ms ease-out}.tap-token{transition:background-color 120ms ease-out}}
@media(prefers-reduced-motion:reduce){.editor-mask,.math-key,.tap-token{animation:none!important;transition:none!important}}

.compact .visual-hint{display:none;}
