<view class="editor-mask {{closing ? 'closing' : ''}}" style="height:{{overlayHeight}}px;">
 <view class="editor-backdrop" bindtap="pause" catchtouchmove="hold"></view>
 <view class="editor-sheet {{compact ? 'compact' : ''}}" style="bottom:{{sheetBottom}}px;height:{{sheetHeight}}px;padding-bottom:{{paddingBottom}}px;" catchtap="hold">
  <view class="sheet-head"><button class="sheet-action" bindtap="cancel" style="width:auto;margin:0;">取消</button><text class="sheet-title">{{working.type === 'text' ? '修改文字' : '修改公式'}}</text><button class="sheet-action done" disabled="{{finishing}}" bindtap="done" style="width:auto;margin:0;">完成</button></view>
  <scroll-view wx:if="{{working.type === 'text'}}" class="sheet-content" scroll-y scroll-into-view="{{scrollTarget}}">
   <textarea id="editor-text" class="text-editor" value="{{textValue}}" bindinput="textInput" bindfocus="textFocus" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" hold-keyboard maxlength="2000" auto-height placeholder="输入文字" />
  </scroll-view>
  <block wx:else>
   <view class="visual-hint">{{holeCount ? '空位会保留，可继续修改其他位置' : hasSelection ? '点其他内容即可切换' : '点选要修改的数字或符号'}}</view>
   <scroll-view class="math-canvas" scroll-x scroll-y enhanced show-scrollbar>
    <view id="formula-stage" data-revision="{{renderRevision}}" class="formula-stage" bindtap="formulaTap"><math-content wx:if="{{!visualNodes.length}}" document-json="{{previewJson}}" /><template wx:else is="math-node-0" data="{{nodes:visualNodes,activeToken,caretToken}}" /></view>
   </scroll-view>
   <view class="editor-error" wx:if="{{error}}">{{error}}</view><view class="sheet-note" wx:elif="{{notice}}">{{notice}}</view>
   <view class="math-keypad">
    <view class="keypad-tools">
     <view class="keypad-tabs"><button style="width:40px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="keypad-tab {{keypadTab === 'numbers' ? 'chosen' : ''}}" data-tab="numbers" bindtap="changeKeypad">123</button><button style="width:40px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="keypad-tab {{keypadTab === 'letters' ? 'chosen' : ''}}" data-tab="letters" bindtap="changeKeypad">abc</button><button style="width:40px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="keypad-tab {{keypadTab === 'more' ? 'chosen' : ''}}" data-tab="more" bindtap="changeKeypad">更多</button></view>
     <button style="width:44px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="pad-tool" data-direction="-1" bindtap="move" aria-label="上一处">‹</button><button style="width:44px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="pad-tool" data-direction="1" bindtap="move" aria-label="下一处">›</button><button style="width:44px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="pad-tool undo {{!canUndo ? 'muted' : ''}}" bindtap="undo" bindlongpress="restoreOriginal" aria-label="撤销，长按恢复原式">↶</button><button id="pad-delete" style="width:44px;min-width:0;margin:0;padding:0;flex-shrink:0;" class="pad-tool" bindtap="erase" aria-label="删除">⌫</button>
    </view>
    <view class="keypad-grid {{keypadTab === 'letters' ? 'letters' : ''}}"><button wx:for="{{keys}}" wx:key="*this" class="math-key" style="width:100%;min-width:0;margin:0;padding:0;" data-key="{{item}}" bindtap="keyTap" hover-class="key-pressed" hover-stay-time="70"><view wx:if="{{item === 'a/b'}}" class="fraction-key"><text>a</text><text>b</text></view><text wx:else>{{item}}</text></button></view>

   </view>
  </block>
 </view>
</view>
