<navigation-bar class="main-navigation" title="录入错题" back="{{true}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list">
  <view class="page-body">
    <button class="photo-action" bindtap="goCamera" disabled="{{recognizing}}" style="width:auto;margin-left:0;margin-right:0;align-self:flex-start;background:transparent;color:#3266ed;opacity:1;"><view class="ui-icon icon-camera"></view><text>{{recognizing ? '正在识别题目和作答…' : '从照片录入'}}</text></button>
    <view class="ocr-review" wx:if="{{ocrReview.length}}"><text class="ocr-review-line" wx:for="{{ocrReview}}" wx:key="*this">{{item}}</text></view>
    <view class="field"><view class="field-header"><text class="field-label">题目</text><text class="field-mark">必填</text><text class="counter">{{questionLen}}/2000</text></view><textarea class="form-textarea math-copy" placeholder="输入完整题目，包括已知条件和问题" placeholder-class="placeholder" maxlength="2000" value="{{question}}" bindinput="onQuestionInput" disabled="{{recognizing}}" auto-height /></view>
    <view class="field"><view class="field-header"><text class="field-label">我的作答</text><text class="field-mark">选填</text><text class="counter">{{answerLen}}/1000</text></view><textarea class="form-textarea answer math-copy" placeholder="输入你的答案或解题步骤" placeholder-class="placeholder" maxlength="1000" value="{{wrongAnswer}}" bindinput="onAnswerInput" disabled="{{recognizing}}" auto-height /></view>
    <button class="action-primary" bindtap="onSubmit" disabled="{{submitting || recognizing}}" loading="{{submitting && !streamChars}}" hover-class="button-hover" style="width:100%;margin-left:0;margin-right:0;background:{{submitting ? '#647086' : '#3266ed'}};color:#fff;opacity:1;">{{submitting ? '正在分析…' : '分析错因'}}</button>
    <view class="save-note">{{saveState}}</view>
    <button wx:if="{{saveConflict}}" class="action-secondary" bindtap="saveAsNew">另存为新草稿</button>
    <view class="task-note" wx:if="{{taskMessage}}">{{taskMessage}}</view>
    <button class="quiet-action task-link" bindtap="goDrafts">查看草稿与任务</button>
  </view>
</scroll-view>
<study-tabs class="main-tabs" active="home"></study-tabs>
