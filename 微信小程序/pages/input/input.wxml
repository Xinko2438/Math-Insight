<navigation-bar class="main-navigation" title="录入题目" back="{{true}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list">
  <view class="page-body">
    <view class="input-toolbar"><button class="photo-action" bindtap="goCamera" disabled="{{recognizing}}" hover-class="button-hover" style="width:auto;margin-left:0;margin-right:0;align-self:flex-start;background:transparent;color:#3266ed;opacity:1;"><view class="ui-icon icon-camera"></view><text>{{recognizing ? '正在识别题目和作答…' : '从照片录入'}}</text></button><button wx:if="{{sourceImage}}" class="original-photo" bindtap="previewPhoto" style="width:auto;margin:0 0 0 auto;">原图</button><text class="saved-hint" wx:if="{{saveState === '已保存'}}">已自动保存</text></view>
    <view class="photo-notice" wx:if="{{photoNotice}}">{{photoNotice}}</view>
    <view class="ocr-review" wx:if="{{ocrReview.length}}"><text class="ocr-review-line" wx:for="{{ocrReview}}" wx:key="*this">{{item}}</text></view>
    <view class="field {{focusedField === 'question' ? 'is-focused' : ''}}"><view class="field-header"><text class="field-label">题目</text><text class="field-mark">必填</text><text class="counter" wx:if="{{!questionDoc && (focusedField === 'question' || questionLen >= 1800)}}">{{questionLen}}/2000</text><button wx:if="{{!questionDoc}}" class="header-formula" data-field="question" bindtap="addMath" style="width:auto;margin:0 0 0 auto;">添加公式</button></view><math-content id="question-math" wx:if="{{questionDoc}}" document-json="{{questionDocJson}}" editable field="question" bindedit="editBlock" /><textarea wx:else class="form-textarea math-copy" placeholder="输入完整题目，包括已知条件和问题" placeholder-class="placeholder" maxlength="2000" value="{{question}}" bindinput="onQuestionInput" data-field="question" bindfocus="onFieldFocus" bindblur="onFieldBlur" disabled="{{recognizing}}" auto-height /><view wx:if="{{questionDoc}}" class="doc-tools"><button data-field="question" bindtap="addMath" style="width:auto;margin:0;">添加公式</button><button wx:if="{{questionDoc}}" data-field="question" bindtap="addText" style="width:auto;margin:0;">添加文字</button><text wx:if="{{questionDoc}}">点内容即可修改</text></view></view>
    <view class="field {{focusedField === 'answer' ? 'is-focused' : ''}}"><view class="field-header"><text class="field-label">我的作答</text><text class="field-mark">选填</text><text class="counter" wx:if="{{!wrongAnswerDoc && (focusedField === 'answer' || answerLen >= 900)}}">{{answerLen}}/1000</text><button wx:if="{{!wrongAnswerDoc}}" class="header-formula" data-field="wrongAnswer" bindtap="addMath" style="width:auto;margin:0 0 0 auto;">添加公式</button></view><math-content id="answer-math" wx:if="{{wrongAnswerDoc}}" document-json="{{wrongAnswerDocJson}}" editable field="wrongAnswer" bindedit="editBlock" /><textarea wx:else class="form-textarea answer math-copy" placeholder="输入你的答案或解题步骤" placeholder-class="placeholder" maxlength="1000" value="{{wrongAnswer}}" bindinput="onAnswerInput" data-field="answer" bindfocus="onFieldFocus" bindblur="onFieldBlur" disabled="{{recognizing}}" auto-height /><view wx:if="{{wrongAnswerDoc}}" class="doc-tools"><button data-field="wrongAnswer" bindtap="addMath" style="width:auto;margin:0;">添加公式</button><button wx:if="{{wrongAnswerDoc}}" data-field="wrongAnswer" bindtap="addText" style="width:auto;margin:0;">添加文字</button></view></view>
    <button class="action-primary" bindtap="onSubmit" disabled="{{submitting || recognizing || (!hasEditorDraft && primaryMode === 'waiting')}}" loading="{{submitting || (!hasEditorDraft && primaryMode === 'waiting')}}" hover-class="button-hover" style="width:100%;margin-left:0;margin-right:0;background:{{submitting || (!hasEditorDraft && primaryMode === 'waiting') ? '#647086' : '#3266ed'}};color:#fff;opacity:1;">{{submitting ? '正在提交…' : hasEditorDraft ? '继续编辑' : primaryMode === 'waiting' ? '正在分析…' : primaryMode === 'report' ? '查看报告' : '分析错因'}}</button>
    <view class="save-note save-error" wx:if="{{saveState && saveState !== '已保存'}}">{{saveState}}</view>
    <button wx:if="{{saveConflict}}" class="action-secondary" bindtap="saveAsNew">另存为新草稿</button>
    <view class="task-note" wx:if="{{taskMessage}}">{{taskMessage}}</view>
    <view class="continuation-actions"><button wx:if="{{previousReportReady}}" class="quiet-action task-link" bindtap="openTaskResult" hover-class="button-hover" style="width:auto;margin:0;">查看上一次的报告</button><button class="quiet-action task-link" bindtap="goDrafts" hover-class="button-hover" style="width:auto;margin:0;">查看草稿与任务</button></view>
  </view>
</scroll-view>
<study-tabs class="main-tabs" active="home"></study-tabs>
<math-editor id="math-editor" wx:if="{{editorSession || editorClosing}}" session-json="{{editorSessionJson}}" viewport-height="{{editorViewportHeight}}" safe-top="{{editorSafeTop}}" closing="{{editorClosing}}" bindchange="editorChange" bindconfirm="editorDone" bindcancel="editorCancel" bindpause="editorPause" />
