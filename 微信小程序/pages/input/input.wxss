.photo-action { min-height: 44px; display: inline-flex; align-items: center; color: #3266ed; font-size: 28rpx; padding: 0 0 12rpx; font-weight: 400; }
.photo-action .ui-icon { margin-right: 24rpx; }
.ocr-review { margin-top: 12rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #eef3ff; color: #2455c5; font-size: 26rpx; line-height: 1.8; }
.ocr-review-line { display: block; }
.field { padding: 28rpx; background: #fff; border: 1rpx solid #e5eaf2; border-radius: 32rpx; margin: 20rpx 0 28rpx; }
.field-header { display: flex; align-items: center; margin-bottom: 20rpx; font-size: 30rpx; font-weight: 500; }
.field-mark { margin-left: 16rpx; color: #647086; font-size: 24rpx; font-weight: 400; }
.counter { margin-left: auto; padding-left: 20rpx; color: #647086; font-size: 24rpx; font-weight: 400; }
.form-textarea { width: 100%; min-height: 180rpx; padding: 0; color: #182237; background: transparent; font-size: 32rpx; line-height: 1.85; letter-spacing: .8rpx; }
.form-textarea.answer { min-height: 160rpx; }
.placeholder { color: #647086; }
.stream-box { margin-top: 24rpx; padding: 26rpx; border-radius: 20rpx; background: #eef3ff; color: #3266ed; font-size: 28rpx; line-height: 1.8; }
.save-note { margin-top: 20rpx; color: #647086; font-size: 24rpx; line-height: 1.8; text-align: center; }
.task-note { margin-top:24rpx; color:#435774; font-size:26rpx; line-height:1.8; }
.task-link { display:block; margin:12rpx auto 0; padding:16rpx; color:#3266ed; font-size:26rpx; }
