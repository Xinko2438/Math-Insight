page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.page {
  flex: 1;
  min-height: 0;
  background: #f3efe7;
  padding-bottom: 60rpx;
}

.card {
  margin: 32rpx 32rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 92, 91, 0.08);
}

.label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.required {
  color: #c96f5a;
  margin-right: 8rpx;
}

.counter {
  margin-left: auto;
  font-size: 22rpx;
  font-weight: 400;
  color: #c7bda9;
}

.textarea {
  width: 100%;
  box-sizing: border-box;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  background: #faf8f2;
  border: 2rpx solid #ece5d5;
  border-radius: 16rpx;
  padding: 20rpx;
}

.ph {
  color: #c7bda9;
  font-size: 26rpx;
}

.textarea.question {
  min-height: 220rpx;
}

.textarea.answer {
  min-height: 160rpx;
}

.btn-wrap {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}

.submit-btn {
  width: 560rpx;
  margin: 0;
  background: #3c5c5b;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 18rpx 0;
  box-shadow: 0 10rpx 24rpx rgba(60, 92, 91, 0.28);
}

.submit-btn[disabled] {
  opacity: 0.7;
  color: #fff;
}

.hint {
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: #b0a48c;
}

.stream-box {
  margin: 24rpx 32rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 92, 91, 0.08);
}

.stream-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #3c5c5b;
  margin-bottom: 16rpx;
}

.stream-dots {
  display: flex;
  align-items: center;
  margin: 8rpx 0 20rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #6ed3cf;
  margin-right: 14rpx;
  animation: blink 1.2s infinite;
}

.dot.d2 {
  animation-delay: 0.2s;
}

.dot.d3 {
  animation-delay: 0.4s;
}

@keyframes blink {
  0%, 100% {
    opacity: 0.25;
  }
  50% {
    opacity: 1;
  }
}

.stream-progress {
  font-size: 24rpx;
  color: #a89c86;
  line-height: 1.7;
}
