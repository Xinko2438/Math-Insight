.draft-row,.task-row { display:flex; align-items:center; padding:24rpx 0; border-bottom:1rpx solid #e5eaf2; }
.task-heading { margin-top:48rpx; }
.row-main { flex:1; min-width:0; text-align:left; font-weight:400; min-height:56px; padding:8rpx 0; border-radius:12rpx; }
.task-row { width:100%; }
.row-title,.row-sub { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.row-title { font-size:30rpx; line-height:1.8; }
.row-sub { color:#647086; font-size:25rpx; margin-top:8rpx; }
.status-ready { color:#3266ed; }
.more-action { color:#647086; font-size:25rpx; min-width:44px; min-height:44px; padding:16rpx; border-radius:12rpx; font-weight:400; }
.row-pressed { background:#edf2fc; }
.row-main,.more-action { transition: none; }
@media (prefers-reduced-motion: no-preference) {
  .row-main,.more-action { transition:background-color 120ms ease-out; }
}
.notice { color:#9a5038; margin-top:24rpx; }
