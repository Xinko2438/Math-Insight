<navigation-bar class="main-navigation" title="草稿与任务" back="{{true}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list"><view class="page-body">
  <view class="section-head"><text class="section-title">草稿 {{drafts.length}}</text></view>
  <view class="draft-row" wx:for="{{drafts}}" wx:key="id"><button class="row-main" data-id="{{item.id}}" bindtap="openDraft" style="width:0;flex:1;margin:0;text-align:left;"><text class="row-title">{{item.title}}</text><text class="row-sub">继续编辑</text></button><button class="delete" data-id="{{item.id}}" bindtap="deleteDraft" style="width:auto;margin:0;">删除</button></view>
  <view class="section-head task-heading"><text class="section-title">分析任务 {{tasks.length}}</text><button class="quiet-action" bindtap="refreshAll" style="width:auto;margin:0 0 0 auto;">刷新</button></view>
  <view class="task-row" wx:for="{{tasks}}" wx:key="id"><button class="row-main" data-id="{{item.id}}" bindtap="openTask" style="width:100%;margin:0;text-align:left;"><text class="row-title">{{item.title}}</text><text class="row-sub">{{item.status}}</text></button><view class="task-actions"><button class="delete" data-id="{{item.id}}" bindtap="deleteTask" style="width:auto;margin:0 32rpx 0 0;">删除任务</button><button class="delete" data-id="{{item.id}}" bindtap="deleteLocalTask" style="width:auto;margin:0;">仅删本机</button></view></view>
  <view wx:if="{{loadError}}" class="notice">{{loadError}}</view>
</view></scroll-view><study-tabs class="main-tabs" active="home"></study-tabs>
