<navigation-bar class="main-navigation" title="草稿与任务" back="{{true}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list"><view class="page-body">
  <view class="section-head"><text class="section-title">草稿 {{drafts.length}}</text></view>
  <view class="draft-row" wx:for="{{drafts}}" wx:key="id"><button class="row-main" data-id="{{item.id}}" bindtap="openDraft" hover-class="row-pressed" style="width:0;flex:1;margin:0;text-align:left;"><text class="row-title">{{item.title}}</text><text class="row-sub">继续编辑</text></button><button class="more-action" data-id="{{item.id}}" data-kind="draft" bindtap="openMore" hover-class="row-pressed" aria-label="草稿的更多操作" style="width:auto;margin:0;">更多</button></view>
  <view class="section-head task-heading"><text class="section-title">分析任务 {{tasks.length}}</text><button class="quiet-action" bindtap="refreshAll" style="width:auto;margin:0 0 0 auto;">刷新</button></view>
  <view class="task-row" wx:for="{{tasks}}" wx:key="id"><button class="row-main" data-id="{{item.id}}" bindtap="openTask" hover-class="row-pressed" style="width:0;flex:1;margin:0;text-align:left;"><text class="row-title">{{item.title}}</text><text class="row-sub {{item.ready ? 'status-ready' : ''}}">{{item.status}}</text></button><button class="more-action" data-id="{{item.id}}" data-kind="task" bindtap="openMore" hover-class="row-pressed" aria-label="分析任务的更多操作" style="width:auto;margin:0;">更多</button></view>
  <view wx:if="{{loadError}}" class="notice">{{loadError}}</view>
</view></scroll-view><study-tabs class="main-tabs" active="home"></study-tabs>
