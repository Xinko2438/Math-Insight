<navigation-bar class="main-navigation" title="错因智诊" back="{{false}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list">
  <view class="page-body">
    <view class="entry-options">
      <view class="scan-card">
        <view class="scan-title">拍照录题</view><view class="scan-copy">支持相册选图</view>
        <view class="scan-art" aria-hidden="true"><view class="scan-corner tl"></view><view class="scan-corner tr"></view><view class="scan-corner bl"></view><view class="scan-corner br"></view><text class="scan-formula">2(x − 3) = x + 4</text></view>
        <button class="scan-button" bindtap="goCamera" disabled="{{recognizing}}" hover-class="button-hover" style="width:254rpx;min-width:0;margin:0;background:#fff;color:#3266ed;opacity:1;"><view class="ui-icon icon-camera" wx:if="{{!recognizing}}"></view><text>{{recognizing ? '正在识别…' : '拍照录入'}}</text></button>
      </view>
      <view class="entry-row">
        <button class="manual-button" bindtap="goInput" hover-class="button-hover" style="margin:0 12rpx 0 0;"><view class="ui-icon icon-edit"></view><text>手动录入</text></button>
        <button class="draft-entry" bindtap="goDrafts" hover-class="button-hover" style="margin:0;"><text class="draft-label">草稿与任务</text><text class="draft-count">{{draftCount}}</text></button>
      </view>
    </view>
    <view class="section-head"><text class="section-title">最近错题</text><button class="quiet-action" bindtap="goHistory" wx:if="{{totalRecords}}" style="width:auto;margin-left:0;margin-right:0;">全部 {{totalRecords}} 道</button></view>
    <view class="recent-list" wx:if="{{recentRecords.length}}">
      <button class="recent-row" wx:for="{{recentRecords}}" wx:key="id" data-id="{{item.id}}" bindtap="viewRecent" hover-class="button-hover" style="width:100%;margin-left:0;margin-right:0;"><view class="recent-body"><view class="recent-question">{{item.question}}</view><view class="recent-cause">{{item.cause}}</view></view><view class="chevron"></view></button>
    </view>
    <view class="recent-empty" wx:else><view>还没有错题</view><text>把报告存入错题本后，题目会显示在这里。</text></view>
  </view>
</scroll-view>
<study-tabs class="main-tabs" active="home"></study-tabs>
