page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.page {
  flex: 1;
  min-height: 0;
  background: #f3efe7;
  padding-bottom: 60rpx;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #efe9db;
  color: #b7a992;
  font-size: 56rpx;
  line-height: 140rpx;
  text-align: center;
  margin: 0 auto;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #a89c86;
}

.overview {
  display: flex;
  margin: 32rpx 32rpx 0;
  padding: 32rpx 0;
  background: #3c5c5b;
  border-radius: 24rpx;
}

.ov-item {
  flex: 1;
  text-align: center;
}

.ov-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
}

.ov-num.small {
  font-size: 28rpx;
  line-height: 1.5;
  padding: 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ov-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.card {
  margin: 32rpx 32rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 92, 91, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3c5c5b;
  margin-bottom: 24rpx;
  border-left: 8rpx solid #6ed3cf;
  padding-left: 20rpx;
}

.bar-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.bar-name {
  width: 220rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #555;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-name.cause {
  width: 300rpx;
  white-space: normal;
  line-height: 1.4;
}

.bar-track {
  flex: 1;
  height: 20rpx;
  background: #ece5d5;
  border-radius: 12rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #6ed3cf;
  border-radius: 12rpx;
}

.bar-fill.orange {
  background: #b7a992;
}

.bar-count {
  width: 160rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
  color: #a89c86;
  white-space: nowrap;
}

.tip-text {
  font-size: 24rpx;
  color: #a89c86;
  line-height: 1.7;
}

.tree-guide {
  font-size: 22rpx;
  color: #a89c86;
  background: #f7f1e3;
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.tree-branch {
  margin-bottom: 16rpx;
}

.branch-head.empty {
  opacity: 0.55;
}

.tree-cat {
  margin: 8rpx 0 4rpx;
}

.cat-head {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx 10rpx 28rpx;
}

.cat-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 3rpx;
  background: #6ed3cf;
  margin-right: 14rpx;
  flex-shrink: 0;
}

.cat-name {
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  color: #3c5c5b;
}

.cat-count {
  font-size: 22rpx;
  color: #a89c86;
}

.branch-leaf.zero {
  opacity: 0.45;
}

.branch-leaf.zero .leaf-dot {
  background: #d8d0bd;
}

.branch-leaf:not(.zero) .leaf-dot {
  background: #3c5c5b;
}

.branch-leaf:not(.zero) .leaf-name {
  color: #333;
  font-weight: 600;
}

.branch-head {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #f0ece0;
  border-radius: 16rpx;
}

.branch-arrow {
  color: #3c5c5b;
  margin-right: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  width: 32rpx;
  text-align: center;
}

.branch-name {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}

.branch-count {
  font-size: 22rpx;
  color: #a89c86;
}

.branch-leaf {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 20rpx 10rpx 44rpx;
}

.leaf-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b7a992;
  margin: 12rpx 16rpx 0 0;
  flex-shrink: 0;
}

.leaf-name {
  flex: 1;
  font-size: 24rpx;
  color: #555;
  line-height: 1.5;
}

.leaf-count {
  font-size: 22rpx;
  color: #b7a992;
  flex-shrink: 0;
}

.advice {
  margin: 32rpx;
  padding: 28rpx 32rpx;
  background: #3c5c5b;
  color: #fff;
  font-size: 26rpx;
  line-height: 1.8;
  border-radius: 20rpx;
  border-left: 10rpx solid #6ed3cf;
  box-shadow: 0 8rpx 20rpx rgba(60, 92, 91, 0.25);
}
