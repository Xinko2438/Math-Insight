.metrics-summary { display: flex; flex-direction: row; padding: 28rpx 0; background: #fff; border: 1rpx solid #e5eaf2; border-radius: 32rpx; }
.metric { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 0 12rpx; }
.metric-bordered { border-left: 1rpx solid #e5eaf2; }
.metric-value { color: #3266ed; font-size: 44rpx; line-height: 1.35; font-weight: 500; }
.metric-label { color: #647086; font-size: 25rpx; line-height: 1.7; margin-top: 10rpx; }
.distribution-row { display: flex; flex-direction: row; margin-bottom: 24rpx; }
.bar-row { flex: 1; width: 0; min-width: 0; }
.column-left { margin-right: 20rpx; }
.cause-list { padding: 4rpx 24rpx; background: #fff; border: 1rpx solid #e5eaf2; border-radius: 24rpx; }
.cause-row, .tree-summary { display: flex; flex-direction: row; justify-content: space-between; padding: 18rpx 0; font-size: 28rpx; line-height: 1.8; }
.cause-row > text:last-child, .tree-summary > text:last-child { color: #647086; margin-left: 20rpx; flex-shrink: 0; }
.chart-guide { margin-bottom: 24rpx; }
.bar-label { display: flex; flex-direction: row; justify-content: space-between; margin-bottom: 10rpx; font-size: 27rpx; line-height: 1.8; }
.bar-label > text:first-child { flex: 1; min-width: 0; margin-right: 12rpx; word-break: break-word; }
.bar-label .small-label { font-size: 24rpx; flex-shrink: 0; }
.bar-track { height: 8rpx; border-radius: 8rpx; background: #e5eaf2; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 8rpx; background: #3266ed; }
.tree-guide { margin-bottom: 16rpx; }
.branch-head { min-height: 48px; display: flex; flex-direction: row; align-items: center; width: 100%; padding: 24rpx 0; border-bottom: 1rpx solid #e5eaf2; font-size: 28rpx; font-weight: 400; text-align: left; }
.branch-toggle { color: #3266ed; font-size: 32rpx; width: 28rpx; margin-right: 20rpx; flex-shrink: 0; }
.branch-name { flex: 1; min-width: 0; }
.branch-head .small-label { margin-left: 20rpx; }
.tree-category { padding: 16rpx 0 12rpx 28rpx; }
.category-head { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: 25rpx; color: #647086; }
.category-head > text:first-child { margin-right: 20rpx; }
.tree-leaf { display: flex; justify-content: space-between; padding: 15rpx 0 15rpx 20rpx; color: #3266ed; font-size: 25rpx; line-height: 1.8; }
.tree-leaf > text:first-child { flex: 1; min-width: 0; margin-right: 20rpx; }
.zero { color: #647086; }
