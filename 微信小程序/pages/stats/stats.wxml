<navigation-bar class="main-navigation" title="错题统计" back="{{false}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list"><view class="page-body">
  <view class="metrics-summary">
    <view class="metric"><text class="metric-value">{{total}}</text><text class="metric-label">错题总数</text></view>
    <view class="metric metric-bordered"><text class="metric-value">{{kpCount}}</text><text class="metric-label">涉及考点</text></view>
    <view class="metric metric-bordered"><text class="metric-value">{{causeCount}}</text><text class="metric-label">错因种类</text></view>
  </view>
    <view class="section-head"><text class="section-title">考点分布</text></view><view class="small-label chart-guide">按记录次数统计，不代表掌握程度。</view>
    <view class="distribution">
      <view class="distribution-row" wx:for="{{kpRows}}" wx:for-item="row" wx:key="key">
        <view class="bar-row {{index === 0 ? 'column-left' : ''}}" wx:for="{{row.items}}" wx:key="name"><view class="bar-label"><text>{{item.name}}</text><text class="small-label">{{item.count}} 题 / {{item.percent}}%</text></view><view class="bar-track"><view class="bar-fill" style="width: {{item.percent}}%;"></view></view></view>
      </view>
    </view>
    <view class="section-head"><text class="section-title">错因次数</text></view><view class="cause-list"><view class="cause-row" wx:for="{{causeDisplay}}" wx:key="name"><text>{{item.name}}</text><text>{{item.count}} 次</text></view></view>
    <view class="section-head"><text class="section-title">错因分类</text></view><view class="small-label tree-guide" wx:if="{{causeTree.length}}">点击考点查看分类与次数。</view>
    <view class="tree-branch" wx:for="{{causeTree}}" wx:key="name"><button class="branch-head {{item.count ? '' : 'zero'}}" data-index="{{index}}" bindtap="toggleBranch" style="width:100%;margin-left:0;margin-right:0;"><text class="branch-toggle">{{item.expanded ? '−' : '+'}}</text><text class="branch-name">{{item.name}}</text><text class="small-label">{{item.count}} 次</text></button><block wx:if="{{item.expanded}}"><view class="tree-category" wx:for="{{item.categories}}" wx:for-item="cat" wx:key="name"><view class="category-head"><text>{{cat.name}}</text><text>{{cat.count}} 次</text></view><view class="tree-leaf {{leaf.count ? '' : 'zero'}}" wx:for="{{cat.children}}" wx:for-item="leaf" wx:key="name"><text>{{leaf.name}}</text><text>× {{leaf.count}}</text></view></view></block></view>
  <view class="tree-summary" wx:if="{{!causeTree.length}}"><text>错因计数</text><text>{{causeTotal}} 次</text></view>
</view></scroll-view><study-tabs class="main-tabs" active="stats"></study-tabs>
