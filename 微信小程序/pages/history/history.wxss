.search-bar { margin: 0 0 12rpx; min-height: 48px; display: flex; flex-direction: row; align-items: center; background: #fff; border: 1rpx solid #e5eaf2; border-radius: 24rpx; padding: 0 26rpx; color: #647086; }
.search-bar .icon-search { margin-right: 26rpx; }
.search-input { flex: 1; min-width: 0; height: 48px; font-size: 28rpx; color: #182237; }
.filter-tabs { display: flex; flex-direction: row; align-items: center; border-bottom: 1rpx solid #e5eaf2; }
.filter-tab { display: flex; flex-direction: row; align-items: center; min-height: 44px; padding: 10rpx 0; margin-right: 36rpx; border-bottom: 4rpx solid transparent; color: #647086; font-size: 27rpx; font-weight: 400; }
.filter-tab.active { color: #3266ed; border-bottom-color: #3266ed; font-weight: 500; }
.filter-arrow { width: 10rpx; height: 10rpx; margin-left: 10rpx; margin-top: -5rpx; border-right: 2rpx solid currentColor; border-bottom: 2rpx solid currentColor; transform: rotate(45deg); flex-shrink: 0; }
.filter-arrow.open { margin-top: 5rpx; transform: rotate(225deg); }
.filter-options { padding: 12rpx 0; border-bottom: 1rpx solid #e5eaf2; }
.options-scroll { white-space: nowrap; width: 100%; height: 90rpx; min-height: 44px; }
.filter-option { display: inline-flex; min-height: 44px; align-items: center; color: #647086; font-size: 26rpx; font-weight: 400; vertical-align: middle; }
.filter-option.selected, .create-tag { color: #3266ed; }
.tag-filter-head { display: flex; flex-direction: row; justify-content: space-between; align-items: center; color: #647086; font-size: 25rpx; }
.tag-filter-head button, .manage-tag-row button { min-height: 44px; color: #3266ed; font-size: 25rpx; font-weight: 400; }
.manage-tag-row { display: flex; flex-direction: row; align-items: center; min-height: 44px; font-size: 27rpx; }
.manage-tag-row > text:first-child { flex: 1; min-width: 0; }
.filter-selection { display: flex; flex-direction: row; flex-wrap: wrap; padding-top: 12rpx; color: #647086; font-size: 24rpx; }
.filter-selection text { margin-right: 24rpx; }
.record-count { font-size: 25rpx; color: #647086; }
.book-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin: 20rpx 0 14rpx; }
.book-list { border-top: 1rpx solid #e5eaf2; min-height: 88rpx; }
.record { padding: 24rpx 0; border-bottom: 1rpx solid #e5eaf2; }
.record-mainline { display: flex; flex-direction: row; align-items: center; }
.record-open { flex: 1; min-width: 0; padding: 0; text-align: left; font-weight: 400; }
.record-question { font-size: 30rpx; letter-spacing: .8rpx; line-height: 1.85; word-break: break-word; }
.record-meta { display: flex; flex-direction: row; align-items: center; margin-top: 8rpx; }
.record-meta-content { flex: 1; min-width: 0; }
.record-kp, .record-time, .record-tag-name { color: #647086; font-size: 24rpx; margin-right: 18rpx; }
.record-tag-name { color: #3266ed; }
.record-tag-action { min-height: 44px; padding: 8rpx 12rpx; color: #3266ed; font-size: 25rpx; font-weight: 400; flex-shrink: 0; }
.record-delete { display: flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; color: #647086; padding: 20rpx; }
.clear-action { padding: 24rpx 0; margin-top: 24rpx; min-height: 44px; text-align: left; font-size: 25rpx; color: #a44235; font-weight: 400; }
.tag-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 20; background: rgba(20, 32, 52, .32); display: flex; flex-direction: column; justify-content: flex-end; }
.tag-sheet { background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 28rpx 40rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.tag-sheet-head { display: flex; flex-direction: row; align-items: center; justify-content: space-between; font-size: 32rpx; font-weight: 500; }
.tag-sheet-head button { min-height: 44px; color: #3266ed; font-size: 27rpx; font-weight: 400; }
.tag-sheet-hint { margin: 8rpx 0 14rpx; color: #647086; font-size: 25rpx; }
.tag-sheet-list { max-height: 360rpx; }
.tag-sheet-row button { min-height: 44px; display: flex; flex-direction: row; justify-content: space-between; align-items: center; border-bottom: 1rpx solid #e5eaf2; font-size: 28rpx; font-weight: 400; text-align: left; }
.tag-check { color: #3266ed; margin-left: 20rpx; }
.tag-sheet-create { min-height: 48px; margin-top: 14rpx; color: #3266ed; font-size: 28rpx; font-weight: 400; text-align: left; }
