page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.page {
  flex: 1;
  min-height: 0;
  background: #f3efe7;
  padding-bottom: 60rpx;
}

.search-bar {
  padding: 24rpx 32rpx 0;
}

.search-input {
  background: #fff;
  border-radius: 36rpx;
  padding: 18rpx 32rpx;
  font-size: 26rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 92, 91, 0.06);
}

.ph {
  color: #c7bda9;
  font-size: 26rpx;
}

.filter-bar {
  white-space: nowrap;
  padding: 24rpx 32rpx 8rpx;
}

.filter-tag {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: #fff;
  color: #777;
  font-size: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(60, 92, 91, 0.06);
}

.filter-tag.active {
  background: #3c5c5b;
  color: #fff;
}

.empty {
  padding: 160rpx 0;
  text-align: center;
}

.empty-icon {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #efe9db;
  color: #b7a992;
  font-size: 56rpx;
  line-height: 140rpx;
  text-align: center;
  margin: 0 auto;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #a89c86;
}

.record {
  display: flex;
  align-items: center;
  margin: 24rpx 32rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(60, 92, 91, 0.08);
}

.record-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.record-main {
  flex: 1;
  min-width: 0;
}

.record-q {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.record-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.record-kp {
  padding: 4rpx 16rpx;
  background: #e6f4f3;
  color: #3c5c5b;
  font-size: 22rpx;
  border-radius: 24rpx;
  margin-right: 16rpx;
}

.record-time {
  font-size: 22rpx;
  color: #c7bda9;
}

.record-del {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  color: #c96f5a;
  background: #f9ece7;
  border-radius: 24rpx;
}

.clear-wrap {
  display: flex;
  justify-content: center;
  margin-top: 48rpx;
}

.clear-btn {
  width: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #a89c86;
  border: 1rpx solid #d8d0c0;
  border-radius: 999rpx;
}
