<navigation-bar class="main-navigation" title="诊断报告" back="{{true}}" color="#182237" background="#f5f7fb"></navigation-bar>
<scroll-view class="page" scroll-y type="list">
  <view class="page-body">
    <block wx:if="{{result}}">
      <view class="question-card"><view class="question-head"><view class="small-label">原题</view><view class="topic" wx:if="{{result.knowledgePoint}}">{{result.knowledgePoint}}</view></view><view class="question-text"><math-content document-json="{{questionDocJson}}" text="{{result.question}}" /></view><button wx:if="{{sourceImage}}" class="report-tag-action" bindtap="previewOriginal" style="width:auto;margin:0;">对照原图</button><view class="original-work" wx:if="{{wrongAnswer}}"><view class="small-label">我的作答</view><math-content document-json="{{wrongAnswerDocJson}}" text="{{wrongAnswer}}" /></view><button class="report-tag-action" wx:if="{{recordId}}" bindtap="openTagEditor" style="width:auto;margin-left:0;margin-right:0;">添加标签</button></view>
      <view class="source-note" wx:if="{{result.source === 'rule'}}">AI 分析暂不可用，以下是基础复习提示，不能判断作答对错。</view>
      <button class="action-secondary" wx:if="{{canSaveTask}}" bindtap="saveTaskToHistory" style="width:100%;margin:20rpx 0;">存入错题本</button>
      <view class="report-tabs"><button class="report-tab {{activeTab === 'steps' ? 'active' : ''}}" data-tab="steps" bindtap="switchReportTab" style="width:auto;flex:1;min-width:0;margin:0;">分步思考</button><button class="report-tab {{activeTab === 'diagnosis' ? 'active' : ''}}" data-tab="diagnosis" bindtap="switchReportTab" style="width:auto;flex:1;min-width:0;margin:0;">错因分析</button><button class="report-tab {{activeTab === 'variants' ? 'active' : ''}}" data-tab="variants" bindtap="switchReportTab" style="width:auto;flex:1;min-width:0;margin:0;">变式练习</button></view>
      <view wx:if="{{activeTab === 'steps'}}">
        <view class="step" wx:for="{{result.steps}}" wx:key="index"><view class="step-head"><text class="step-number">{{index + 1}}</text><view class="step-content"><view class="step-question"><math-content text="{{item.question}}" /></view><view class="step-actions"><button class="hint-action" data-index="{{index}}" bindtap="toggleHint" wx:if="{{item.hint}}" style="width:auto;min-width:0;margin:0;padding:16rpx 0;">{{item.showHint ? '收起提示' : '查看提示'}}</button><button class="detail-action" data-index="{{index}}" bindtap="toggleDetail" wx:if="{{item.detail}}" style="width:auto;min-width:0;margin:0;padding:16rpx 0;margin-left:{{item.hint ? '36rpx' : '0'}};">{{item.showDetail ? '收起解答' : '本步解答'}}</button></view></view></view><view class="reveal" wx:if="{{item.showHint && item.hint}}"><math-content text="{{item.hint}}" /></view><view class="reveal" wx:if="{{item.showDetail && item.detail}}"><math-content text="{{item.detail}}" /></view></view>
        <button class="solution-toggle" bindtap="toggleSolution" wx:if="{{result.solution}}" style="width:100%;margin-left:0;margin-right:0;"><text>{{solutionExpanded ? '收起完整解答' : '查看完整解答'}}</text><text>{{solutionExpanded ? '−' : '+'}}</text></button><view class="solution" wx:if="{{solutionExpanded && result.solution}}"><math-content text="{{result.solution}}" /></view>
      </view>
      <view wx:if="{{activeTab === 'diagnosis'}}">
        <view class="diagnosis"><math-content text="{{result.diagnosis}}" /></view>
        <view class="cause-list" wx:if="{{result.causeNodes.length}}"><view class="cause-item" wx:for="{{result.causeNodes}}" wx:key="id"><text class="cause-category">{{item.category}}</text><text>{{item.name}}</text></view></view>
        <view class="confidence-note" wx:if="{{result.confidence !== undefined}}">诊断参考分数 {{result.confidence}} / 100<view>分数仅供参考，不代表经验证的准确率。</view></view>
      </view>
      <view wx:if="{{activeTab === 'variants'}}"><view class="small-label" wx:if="{{result.variants.length}}">先独立作答，再展开答案。</view><view class="small-label" wx:else>暂时没有变式题。</view><view class="variant" wx:for="{{result.variants}}" wx:key="index"><view class="variant-level">{{item.level}}</view><math-content text="{{item.question}}" /><button class="variant-toggle" data-index="{{index}}" bindtap="toggleVariant" style="width:auto;margin-left:0;margin-right:0;align-self:flex-start;display:flex;justify-content:flex-start;text-align:left;">{{item.expanded ? '收起答案与解析' : '展开答案与解析'}}</button><view class="variant-detail" wx:if="{{item.expanded}}"><text class="small-label">参考答案</text><math-content text="{{item.answer}}" /><view class="variant-analysis"><math-content text="{{item.analysis}}" /></view></view></view></view>
      <view class="chat-section"><view class="section-title">追问这道题</view><view class="chat-list" wx:if="{{chat.length}}"><view class="chat-item {{item.role}}" wx:for="{{chat}}" wx:key="index"><math-content text="{{item.content}}" /></view><view class="chat-thinking" wx:if="{{chatting}}">正在回复…</view></view><view class="chat-entry"><input class="chat-input" value="{{chatInput}}" bindinput="onChatInput" bindconfirm="sendChat" confirm-type="send" maxlength="500" disabled="{{chatting}}" placeholder="例如：为什么移项要变号？" /><button class="chat-send" bindtap="sendChat" disabled="{{chatting}}" aria-label="发送追问" style="width:94rpx;flex-shrink:0;margin:0 0 0 16rpx;">发送</button></view><view class="chat-error" wx:if="{{chatError}}">{{chatError}}</view></view>
      <button class="action-secondary again-button" bindtap="goAgain" style="width:100%;margin-left:0;margin-right:0;">录入下一题</button>
    </block>
    <view class="empty-state" wx:else><view class="empty-title">暂无诊断报告</view><view class="empty-copy">录入题目并完成分析后查看。</view><button class="action-primary" bindtap="goAgain" style="width:100%;margin-left:0;margin-right:0;">录入一道错题</button></view>
  </view>
</scroll-view>
<study-tabs class="main-tabs" active="home"></study-tabs>
