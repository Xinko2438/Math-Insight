.question-card { padding: 34rpx; background: #fff; border: 1rpx solid #e5eaf2; border-radius: 36rpx; }
.question-head { display: flex; align-items: center; justify-content: space-between; }
.question-head .topic { margin-left: 20rpx; font-size: 24rpx; padding: 4rpx 12rpx; }
.question-text { margin-top: 26rpx; font-size: 38rpx; line-height: 1.75; }
.original-work { margin-top: 22rpx; padding-top: 18rpx; border-top: 1rpx solid #e5eaf2; }
.original-work .math-copy { margin-top: 10rpx; font-size: 30rpx; color: #647086; }
.report-tag-action { min-height: 44px; margin-top: 12rpx; padding: 10rpx 0; color: #3266ed; font-size: 26rpx; font-weight: 400; }
.report-tabs { display: flex; margin: 22rpx 0 20rpx; border-bottom: 1rpx solid #e5eaf2; }
.report-tab { color: #647086; font-size: 27rpx; padding: 18rpx 0; min-height: 44px; border-bottom: 4rpx solid transparent; font-weight: 400; }
.report-tab.active { color: #3266ed; border-bottom-color: #3266ed; font-weight: 500; }
.step { padding: 32rpx; margin-top: 24rpx; border: 1rpx solid #e5eaf2; border-radius: 32rpx; background: #fff; }
.step-head { display: flex; align-items: flex-start; }
.step-number { display: flex; width: 50rpx; height: 50rpx; margin-right: 24rpx; border-radius: 50%; background: #eef3ff; color: #3266ed; align-items: center; justify-content: center; font-size: 25rpx; flex-shrink: 0; line-height: 1.5; }
.step-content { flex: 1; min-width: 0; }
.step-question { font-size: 30rpx; line-height: 1.85; letter-spacing: .5rpx; }
.step-actions { display: flex; margin-top: 8rpx; flex-wrap: wrap; }
.step-actions button { font-size: 25rpx; min-height: 44px; color: #3266ed; padding: 16rpx 0; font-weight: 400; }
.reveal { margin-top: 16rpx; padding: 24rpx; border-radius: 24rpx; background: #eef3ff; font-size: 30rpx; }
.solution-toggle { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 48px; padding: 22rpx 0; color: #3266ed; font-size: 28rpx; font-weight: 400; }
.solution { padding: 28rpx; border: 1rpx solid #e5eaf2; border-radius: 28rpx; background: #fff; font-size: 30rpx; }
.diagnosis { font-size: 30rpx; }
.source-note { color: #647086; font-size: 25rpx; margin-bottom: 20rpx; }
.cause-list { margin-top: 24rpx; }
.cause-item { padding: 20rpx 0; border-bottom: 1rpx solid #e5eaf2; font-size: 28rpx; }
.cause-category { display: block; color: #3266ed; font-size: 24rpx; margin-bottom: 8rpx; }
.confidence-note { margin-top: 28rpx; font-size: 24rpx; color: #647086; line-height: 1.9; }
.variant { padding: 28rpx 0; border-bottom: 1rpx solid #e5eaf2; }
.variant-level { color: #3266ed; font-size: 25rpx; margin-bottom: 16rpx; }
.variant-toggle { color: #3266ed; min-height: 44px; font-size: 25rpx; padding: 18rpx 0; font-weight: 400; text-align: left; }
.variant-detail { padding: 24rpx; background: #eef3ff; border-radius: 18rpx; }
.variant-detail .math-copy { font-size: 30rpx; }
.variant-analysis { margin-top: 16rpx; color: #647086; }
.chat-section { margin-top: 32rpx; padding-top: 28rpx; border-top: 1rpx solid #e5eaf2; }
.chat-entry { display: flex; align-items: center; margin-top: 20rpx; }
.chat-input { flex: 1; min-width: 0; height: 48px; padding: 20rpx; border: 1rpx solid #e5eaf2; border-radius: 18rpx; background: #fff; font-size: 26rpx; }
.chat-send { min-width: 44px; min-height: 48px; border-radius: 18rpx; background: #3266ed; color: #fff; padding: 20rpx 16rpx; font-size: 26rpx; }
.chat-list { margin-top: 20rpx; }
.chat-item { padding: 24rpx; margin-top: 18rpx; border-radius: 20rpx; background: #fff; border: 1rpx solid #e5eaf2; }
.chat-item.user { margin-left: 30rpx; background: #eef3ff; border-color: #eef3ff; }
.chat-item .math-copy { font-size: 30rpx; }
.chat-thinking { color: #647086; font-size: 24rpx; padding: 16rpx 0; }
.chat-error { margin-top: 20rpx; padding: 22rpx; background: #fff0ec; color: #9d392c; font-size: 25rpx; line-height: 1.8; border-radius: 16rpx; }
.again-button { margin-top: 32rpx; }
